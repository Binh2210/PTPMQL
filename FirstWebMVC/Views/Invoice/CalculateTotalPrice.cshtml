@model FirstWebMVC.Models.InvoiceModel

<form asp-action="CalculateTotalPrice" method="post">
    <div>
        <label for="Quantity">Số lượng:</label>
        <input type="text" id="Quantity" name="Quantity" />
    </div>
    <div>
        <label for="UnitPrice">Đơn giá:</label>
        <input type="text" id="UnitPrice" name="UnitPrice" />
    </div>
    <button type="submit">Tính tiền</button>
</form>

@if (ViewBag.TotalPrice != null)
{
    <p>Tổng tiền hóa đơn của bạn là: @ViewBag.TotalPrice</p>
}
